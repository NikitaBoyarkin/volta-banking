      "2024-02         4859    1.000    0.529    0.363    0.317    0.241    0.248   \n",
      "2024-03         4670    1.000    0.527    0.388    0.319    0.303    0.222   \n",
      "2024-04         5253    1.000    0.535    0.391    0.297    0.265    0.232   \n",
